FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Set up build arguments for production database connectivity
ARG NEXT_PUBLIC_POCKETBASE_URL
ENV NEXT_PUBLIC_POCKETBASE_URL=$NEXT_PUBLIC_POCKETBASE_URL
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Build the Next.js application
RUN npm run build

# Expose Next.js port
EXPOSE 3000

# Start server
CMD ["npm", "run", "start"]
